# Backend (glam-backend) API ünvanı, `/api` daxil. Yalnız serverdə istifadə olunur.
GLAM_API_URL=https://glam-az-backend.onrender.com/api

# Socket.io ünvanı (brauzerdən birbaşa qoşulur).
NEXT_PUBLIC_SOCKET_URL=https://glam-az-backend.onrender.com

# Saytın ictimai ünvanı (SEO, canonical, sitemap).
NEXT_PUBLIC_SITE_URL=https://glam.az

# Real giriş testi (scripts/auth-smoke.mjs) üçün test hesabları. Dəyərləri YALNIZ .env.local-a yazın (git-ə düşmür).
TEST_STORE_PHONE=
TEST_CUSTOMER_PHONE=
TEST_PASSWORD=
